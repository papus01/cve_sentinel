# ────────────────────────────────────────────────────────────────
#  CVE SENTINEL — .env.example
#  Copier ce fichier en .env pour les tests locaux.
#  Ne jamais committer le .env réel.
# ────────────────────────────────────────────────────────────────

# ── Telegram (GitHub Secrets) ────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── NVD API (GitHub Secrets) ─────────────────────────────────────
# Optionnel. Augmente les limites de taux de l'API NVD.
# Obtenir une clé gratuite : https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# ── Email SMTP (GitHub Secrets) ──────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# ── Politique de notification (GitHub Variables) ─────────────────
# Ces variables définissent QUI est notifié, pas ce qui est collecté.
# Toutes les CVE sont toujours collectées et enregistrées.

# Envoyer une notification Telegram pour les CVE CRITICAL (CVSS >= 9.0)
ALERT_CRITICAL=true

# Envoyer une notification Telegram pour les CVE HIGH (CVSS >= 7.0)
ALERT_HIGH=true

# Envoyer une notification Telegram pour les CVE MEDIUM (CVSS 4.0-6.9)
ALERT_MEDIUM=false

# Envoyer une notification Telegram pour les CVE LOW (CVSS < 4.0)
ALERT_LOW=false

# Envoyer une notification Telegram pour les CVE dans le catalogue CISA KEV
# (même si leur CVSS est inférieur aux seuils ci-dessus)
ALERT_KEV=true

# Si true, TOUTES les nouvelles CVE sont notifiées sur Telegram
# (écrase tous les réglages ALERT_* ci-dessus)
ALERT_ALL_NEW_CVES=false

# Mode de notification Telegram :
# - individual : un message par CVE prioritaire
# - digest     : un seul résumé quotidien
# - both       : résumé + messages individuels pour CRITICAL/KEV
NOTIFICATION_MODE=both

# ── Collecte (GitHub Variables) ──────────────────────────────────
# IMPORTANT : MIN_CVSS n'empêche JAMAIS la collecte des CVE.
# Il peut seulement réduire les notifications (sauf pour les CVE KEV).
MIN_CVSS=0

# Nombre maximum de nouvelles CVE traitées par exécution (protection anti-flood)
MAX_CVES=1000

# Fenêtre de sécurité : on recule de N heures depuis le dernier run
# pour éviter de manquer des CVE publiées juste avant l'exécution précédente.
LOOKBACK_HOURS=27

# Si le dernier run date de plus de N jours, on recule au maximum de N jours.
MAX_LOOKBACK_DAYS=7

# ── Keywords (GitHub Variables) ──────────────────────────────────
# RÔLE INFORMATIF UNIQUEMENT.
# Les keywords ne filtrent JAMAIS la collecte.
# Ils servent uniquement à :
#   - mettre en avant certaines CVE dans les messages
#   - filtrer l'affichage du dashboard
#   - créer des statistiques supplémentaires
# Une CVE PHP CRITICAL sera toujours détectée même si 'php' est absent.
KEYWORDS=php,linux,microsoft,apache,cisco,fortinet,vmware

# Envoyer un rapport même si aucune nouvelle CVE n'est détectée
SEND_EMPTY_REPORT=false
